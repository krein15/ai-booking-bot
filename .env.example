# Скопируйте в .env и заполните. Файл .env не попадает в git.

# --- Модель -------------------------------------------------------------
# gigachat — настоящая модель; fake — заглушка без модели (проверить сайт и таблицу)
LLM_PROVIDER=gigachat
# «Ключ авторизации» из личного кабинета developers.sber.ru (проект GigaChat API)
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Модели по порядку: когда у модели заканчивается бесплатный пакет токенов,
# бот переходит к следующей. Ultra лучше всех держит сценарий записи и у неё самый большой пакет.
GIGACHAT_MODELS=GigaChat-3-Ultra,GigaChat-2-Max,GigaChat-2-Pro,GigaChat-2
# Корневой сертификат Минцифры (скачивается scripts/get_certs.sh)
GIGACHAT_CA_BUNDLE_FILE=certs/russian_trusted_ca.pem
GIGACHAT_VERIFY_SSL_CERTS=true
# Бесплатный тариф обрабатывает один запрос за раз
GIGACHAT_MAX_CONCURRENCY=1
# Сколько секунд клиент может ждать своей очереди к модели
LLM_QUEUE_TIMEOUT=40

# --- Google Таблица ---------------------------------------------------------
# JSON-ключ сервисного аккаунта и id таблицы (из ссылки .../spreadsheets/d/<ID>/edit)
GOOGLE_CREDENTIALS_FILE=secrets/google-service-account.json
GOOGLE_SHEET_ID=
GOOGLE_WORKSHEET=Записи
# Необязательно: своя ссылка для кнопки «Открыть таблицу» и адрес для встраивания
SHEET_PUBLIC_URL=
SHEET_EMBED_URL=

# --- Telegram ---------------------------------------------------------------
# Токен от @BotFather. Пусто — Telegram-бот выключен.
TELEGRAM_BOT_TOKEN=

# --- Сайт -------------------------------------------------------------------
# С каких сайтов можно обращаться к API (через запятую). * — с любых.
CORS_ORIGINS=*
# Любая случайная строка: нужна, чтобы не хранить IP посетителей в открытом виде
IP_HASH_SALT=change-me

# --- Защита от злоупотреблений -------------------------------------------
MAX_MESSAGE_CHARS=800
MAX_USER_MESSAGES_PER_SESSION=40
IP_MESSAGES_PER_MINUTE=12
IP_MESSAGES_PER_DAY=200
IP_NEW_SESSIONS_PER_DAY=15
IP_BOOKINGS_PER_DAY=5
DAILY_LLM_TURNS_LIMIT=3000
SESSION_TTL_MINUTES=120
